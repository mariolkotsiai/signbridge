# Αντίγραψε σε .env και τρέξε:  uvicorn services.api.main:app --env-file .env
# Όλες οι τιμές είναι προαιρετικές - εδώ φαίνονται οι προεπιλογές.

# --- Αρχεία ---
# SIGNBRIDGE_WEIGHTS_DIR=services/inference/weights
# SIGNBRIDGE_LANDMARKER_MODEL=services/inference/hand_landmarker.task

# --- Sliding window ---
# Ο client στέλνει ~15 frames/s, άρα 30 frames ≈ 2 δευτερόλεπτα νοήματος.
SIGNBRIDGE_WINDOW_FRAMES=30
SIGNBRIDGE_MIN_FRAMES=15
SIGNBRIDGE_STRIDE=3
SIGNBRIDGE_MIN_HAND_RATIO=0.4
SIGNBRIDGE_IDLE_RESET_FRAMES=8

# --- Απόφαση / υπότιτλοι ---
SIGNBRIDGE_THRESHOLD=0.70
SIGNBRIDGE_VOTE_WINDOW=5
SIGNBRIDGE_MIN_VOTES=3

# --- Όρια ---
SIGNBRIDGE_MAX_SESSIONS=2
SIGNBRIDGE_MAX_FRAME_BYTES=2000000
SIGNBRIDGE_MAX_FRAME_WIDTH=640
SIGNBRIDGE_TORCH_THREADS=2

# --- CORS (χρειάζεται μόνο αν το frontend μιλά απευθείας στο backend, χωρίς Vite proxy) ---
# SIGNBRIDGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
